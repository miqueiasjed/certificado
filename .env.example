APP_NAME=Certificado
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://certificado.test

# APP_TIMEZONE permanece UTC: o histórico do banco foi gravado nesse fuso.
# O fuso de exibição e de regra de vencimento é APP_BUSINESS_TIMEZONE.
APP_TIMEZONE=UTC
APP_BUSINESS_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=certificado
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gateway de assinatura (Plano 7)
# Sandbox é o padrão: ambiente sem PAGBANK_SANDBOX definido é ambiente de
# desenvolvimento, e o erro de esquecer a chave precisa cair no lado que não
# cobra ninguém de verdade. Em produção, PAGBANK_SANDBOX=false.
PAGBANK_SANDBOX=true
PAGBANK_TOKEN=
PAGBANK_WEBHOOK_TOKEN=
# URL pública que o PagBank chama ao mudar o estado de uma cobrança avulsa.
# Vazia em desenvolvimento: sem endereço público não há o que notificar.
PAGBANK_WEBHOOK_URL=
# Os quatro endereços abaixo já vêm com o padrão certo em config/services.php;
# só preencha para apontar para um dublê local ou para um host novo do provedor.
# PAGBANK_BASE_URL_SANDBOX=https://sandbox.api.assinaturas.pagseguro.com
# PAGBANK_BASE_URL_PRODUCAO=https://api.assinaturas.pagseguro.com
# PAGBANK_BASE_URL_PEDIDOS_SANDBOX=https://sandbox.api.pagseguro.com
# PAGBANK_BASE_URL_PEDIDOS_PRODUCAO=https://api.pagseguro.com
# PAGBANK_TIMEOUT=20

# Implementação de App\Contracts\GatewayAssinatura. Vazio usa PagBankGateway.
# GATEWAY_ASSINATURA_DRIVER=

# Assinatura eletrônica de contratos (Plano 26).
# NÃO existe token aqui: a credencial do provedor é POR EMPRESA e vive cifrada
# em signature_provider_configs, cadastrada pelo próprio tenant na tela de
# integração. O ambiente (sandbox ou produção) também é por empresa, na mesma
# tabela. Só os endereços são de plataforma, e já vêm com o padrão certo em
# config/services.php; só preencha para apontar para um dublê local.
# ZAPSIGN_BASE_URL_SANDBOX=https://sandbox.api.zapsign.com.br
# ZAPSIGN_BASE_URL_PRODUCAO=https://api.zapsign.com.br

# Régua de inadimplência (Plano 7, Task 7.7). Dias entre o vencimento da fatura
# e a suspensão do acesso do tenant. O padrão de config/assinatura.php é 5, e
# encurtar isto é a mudança mais cara possível aqui: o fim da contagem é
# bloqueio do sistema de um cliente real. Os marcos de aviso e de cobrança não
# passam por variável de ambiente, porque são listas; ficam em
# config/assinatura.php.
# ASSINATURA_DIAS_DE_TOLERANCIA=5

# Geocodificação de endereços (Plano 22, Task 22.2). Implementação de
# App\Services\Geo\ProvedorDeGeocodificacao. Vazio usa ProvedorNominatim
# (OpenStreetMap, gratuito, sem chave de API).
# GEOCODIFICACAO_PROVEDOR_DRIVER=
# Nominatim exige um User-Agent identificando a aplicação. Vazio cai para o
# nome e a URL da aplicação (APP_NAME / APP_URL); troque por um contato de
# verdade antes de rodar contra volume real em produção.
# GEOCODIFICACAO_USER_AGENT=
# GEOCODIFICACAO_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# GEOCODIFICACAO_TIMEOUT=10

# Camada de tiles do mapa exibido em Roteiros/Index.vue e
# Enderecos/PendenciasGeo.vue (Plano 22, Task 22.6). Variável do Vite (só
# variáveis com prefixo VITE_ chegam ao bundle do frontend), lida direto por
# import.meta.env - não passa pelo backend. Vazia usa o tile público do
# OpenStreetMap (gratuito, sem chave de API, mesmo espírito da escolha do
# Nominatim na Task 22.2); troque por um provedor com SLA antes de rodar
# contra volume real em produção (a política de uso do OSM não é para tráfego
# de produção pesado).
# VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
